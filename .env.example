# Local development only. Copy to .env and fill in.
#
# .env is gitignored. The deployed service does not use this file — its
# database URL comes from Secret Manager, because a credential set as a plain
# Cloud Run environment variable is visible to anyone who can read the console.

# Neon pooled connection string (the host contains "-pooler").
API_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Optional overrides; defaults are in src/api/config.py.
# API_LOG_LEVEL=DEBUG
# API_POOL_SIZE=5

# The role caller-supplied SQL runs as. Provision it with
# scripts/sql/readonly_role.sql. Leave empty only if the role cannot be
# created; the tool then runs with the service's own grants.
API_SQL_READONLY_ROLE=catalogue_readonly
