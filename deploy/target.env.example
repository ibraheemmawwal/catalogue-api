# Where this gets deployed, and what that target needs to know.
#
#   cp deploy/target.env.example deploy/target.env
#   $EDITOR deploy/target.env
#   scripts/deploy.sh --check          # tells you what is still missing
#   scripts/deploy.sh v1.2.5
#
# target.env is gitignored. Nothing secret belongs in it — every value here is
# a name or an identifier, and the one actual secret (the database URL) is
# stored in the target's secret manager and referenced by name.
#
# Only the block for your provider has to be filled in. --check reads this
# file, then verifies the account behind it: that the CLI is installed and
# authenticated, that the registry and secret exist, and that the service
# account is real. It is meant to fail on your laptop rather than halfway
# through a deploy.

# gcp | aws | azure
DEPLOY_PROVIDER=gcp


# --- Google Cloud Run -------------------------------------------------------
# Needs: gcloud, a project with billing, Artifact Registry and Cloud Run
# enabled, a service account for the service to run as, and the database URL
# in Secret Manager.
#
#   gcloud services enable run.googleapis.com artifactregistry.googleapis.com \
#       cloudbuild.googleapis.com secretmanager.googleapis.com
#   gcloud artifacts repositories create catalogue --repository-format=docker \
#       --location=<region>
#   printf '%s' "$DATABASE_URL" | gcloud secrets create catalogue-database-url --data-file=-

GCP_PROJECT=book-data-pipeline-2026
GCP_REGION=europe-west2
GCP_REGISTRY=europe-west2-docker.pkg.dev/book-data-pipeline-2026/catalogue
GCP_SERVICE_ACCOUNT=catalogue-api@book-data-pipeline-2026.iam.gserviceaccount.com
GCP_DATABASE_URL_SECRET=catalogue-database-url


# --- AWS App Runner ---------------------------------------------------------
# Needs: aws cli v2, an ECR repository, an access role that lets App Runner
# pull from it, an instance role for the task, and the database URL in Secrets
# Manager.
#
# The awkward part is not credentials, it is that App Runner has no equivalent
# of a Cloud Run revision tag — no way to run a new version on its own URL
# while the old one serves traffic. A staging deploy there is a second service,
# so AWS_STAGING_SERVICE is a separate name rather than a tag.

AWS_REGION=
AWS_ACCOUNT_ID=
AWS_ECR_REPOSITORY=catalogue-api
AWS_SERVICE=book-catalogue
AWS_STAGING_SERVICE=book-catalogue-staging
AWS_ACCESS_ROLE_ARN=
AWS_INSTANCE_ROLE_ARN=
AWS_DATABASE_URL_SECRET=catalogue-database-url
# Optional. App Runner sets an instance ceiling through a separate
# AutoScalingConfiguration resource rather than on the service; without one it
# defaults to 25, which is far above what this service is sized for.
#   aws apprunner create-auto-scaling-configuration \
#       --auto-scaling-configuration-name catalogue --max-size 3
AWS_AUTOSCALING_ARN=


# --- Azure Container Apps ---------------------------------------------------
# Needs: az cli with the containerapp extension, a resource group, an Azure
# Container Registry, a Container Apps environment, a managed identity that can
# pull from the registry and read the secret, and the database URL in Key Vault.
#
#   az extension add --name containerapp
#
# Closest of the three to Cloud Run: revision labels give a new revision its own
# URL while the old one keeps traffic, which is what the staging step needs.

AZURE_SUBSCRIPTION=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=uksouth
AZURE_REGISTRY=
AZURE_ENVIRONMENT=
AZURE_IDENTITY=
AZURE_KEYVAULT=
AZURE_DATABASE_URL_SECRET=catalogue-database-url
